  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "TO ADD BGM IN EACH SCENE (Automatic Scene Detection)\r\n\r\n1. Open the
    S16_AudioManager.cs script.\r\n2. Locate the OnSceneLoaded function.\r\n3. Add
    the scene name and your desired BGM using an else if statement. (Example: else
    if (scene.name == \"Level 3\") { PlayBGM(\"In Game 3\"); })\r\n4. Save the script.
    The music will play automatically when the scene loads\u2014you do not need to
    add any objects to the Unity Hierarchy.\r\n\r\nTO ADD SFX TO UI BUTTONS\r\n\r\n1.
    Identify the existing script and function the button is already using (e.g.,
    StartGame() or QuitGame()).\r\n2. Open that script.\r\n3. Insert this line inside
    the function: S16_AudioManager.instance.PlaySFX(\"UI Buttons Click\");\r\n(Note:
    You can no longer drag the Audio Manager into the On Click () slot in the Inspector
    because the manager now spawns dynamically in the background.)\r\n\r\nTO ADD
    SFX IN GAMEPLAY SCRIPTS (e.g., Jump, Walk, Death)\r\n\r\n1. Open the relevant
    script (e.g., PlayerMovement.cs).\r\n2. Inside the specific function where the
    action occurs (e.g., inside Jump()), insert: S16_AudioManager.instance.PlaySFX(\"Jump\");\r\n\r\nTO
    ADD NEW BGM OR SFX\r\n\r\n1. In your Project window, navigate to the Assets >
    Resources folder.\r\n2. Select the AudioManager prefab.\r\n3. In the Inspector,
    expand the Bgm Sounds or Sfx Sounds list.\r\n4. Click the + button to add a new
    slot, type the exact Name, and drag your audio file into the Clip slot."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
